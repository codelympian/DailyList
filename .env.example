# ============================================================
# Dailylist environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================

NODE_ENV=development

# --- Database (PostgreSQL) ---
# Local devstack (npm run devstack:start) uses port 5433 with trust auth.
# Docker compose uses port 5432 (postgres/postgres).
DATABASE_URL=postgresql://dailylist@localhost:5433/dailylist_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:3200

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Optional AI message wording ---
# Dailylist works fully without this: deterministic templates are always used
# as the fallback, and AI output that states any fact we did not supply is
# rejected. Set to "true" and provide a key to enable AI rewording.
AI_MESSAGES_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
AI_MESSAGE_MODEL=claude-opus-5
AI_MESSAGE_TIMEOUT_MS=8000
