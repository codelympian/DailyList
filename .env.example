# ============================================================
# Dailylist environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================

NODE_ENV=development

# --- Database (PostgreSQL) ---
# Local devstack (npm run devstack:start) uses port 5433 with trust auth.
# Docker compose uses port 5432 (postgres/postgres).
DATABASE_URL=postgresql://dailylist@localhost:5433/dailylist_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
