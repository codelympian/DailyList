# ============================================================
# Dailylist environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================

NODE_ENV=development

# --- Supabase Auth ---
# Identity is Supabase's; this app stores only a profile row keyed by
# auth.users.id. Get these from Project Settings -> API (use the new
# publishable/secret keys, not the legacy anon/service_role JWTs).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Database (PostgreSQL) ---
# Supabase: use the SHARED POOLER (IPv4-reachable); the direct connection is
# IPv6-only unless you buy the add-on. Two URLs are required:
#   DATABASE_URL - transaction pooler (6543) for the running app. Keep
#     pgbouncer=true (disables prepared statements the pooler cannot handle).
#     connection_limit is a real pool for a long-lived server; do NOT set it
#     to 1 - that is serverless guidance and starves concurrent requests.
#   DIRECT_URL   - session pooler (5432); Prisma runs migrations through it.
# Percent-encode any special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Tests run against local PostgreSQL, never Supabase (the suite truncates
# every table). Start it with: npm run devstack:start
TEST_DATABASE_URL=postgresql://dailylist@localhost:5433/dailylist_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:3200

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Optional AI message wording ---
# Dailylist works fully without this: deterministic templates are always used
# as the fallback, and AI output that states any fact we did not supply is
# rejected. Set to "true" and provide a key to enable AI rewording.
AI_MESSAGES_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
AI_MESSAGE_MODEL=claude-opus-5
AI_MESSAGE_TIMEOUT_MS=8000
