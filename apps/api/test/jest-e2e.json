{
  "testEnvironment": "node",
  "rootDir": ".",
  "testMatch": ["**/*.e2e-spec.ts"],
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testTimeout": 30000,
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": { "module": "commonjs", "moduleResolution": "node" } }]
  }
}
