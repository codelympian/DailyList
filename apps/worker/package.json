{
  "name": "@dailylist/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Dailylist background worker (BullMQ). Phase 0: infrastructure heartbeat only.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@dailylist/config": "*",
    "@dailylist/database": "*",
    "@dailylist/importer": "*",
    "bullmq": "^5.56.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
