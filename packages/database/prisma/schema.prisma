// Dailylist database schema.
// Phase 0 intentionally contains no domain models — those arrive with
// their phases (users/businesses in Phase 1, customers in Phase 2, ...).
// HealthCheck exists so the migration pipeline and /health endpoint can
// verify real database connectivity and writes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  service   String
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

// ============================================================
// Phase 1 — Users, sessions, businesses, memberships
// ============================================================

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  memberships BusinessMembership[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  // sha256 of the opaque session token; the raw token only ever lives in the cookie.
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  industry  String?
  currency  String   @default("NGN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  BusinessMembership[]
  customers    Customer[]
  products     Product[]
  transactions Transaction[]
  leads        Lead[]
  importJobs   ImportJob[]

  @@map("businesses")
}

// ============================================================
// Phase 2 — Customers, identities, timeline events
// ============================================================

enum LifecycleStage {
  LEAD
  CUSTOMER
  INACTIVE
  LOST
}

enum CustomerSource {
  MANUAL
  IMPORT
  WHATSAPP
  INSTAGRAM
  OTHER
}

enum IdentityType {
  PHONE
  EMAIL
  WHATSAPP
  INSTAGRAM
  EXTERNAL_ID
}

enum CustomerEventType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  MESSAGE_SENT
  MESSAGE_RECEIVED
  QUOTE_REQUESTED
  QUOTE_SENT
  PURCHASE
  PAYMENT
  DEBT_CREATED
  DEBT_PAYMENT
  FOLLOW_UP
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_SKIPPED
  CUSTOMER_REACTIVATED
  CUSTOMER_LOST
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  businessId     String         @map("business_id") @db.Uuid
  name           String
  // Normalized E.164 (e.g. +2348012345678); raw input is normalized on write.
  phone          String?
  email          String?
  notes          String?
  source         CustomerSource @default(MANUAL)
  lifecycleStage LifecycleStage @default(CUSTOMER) @map("lifecycle_stage")
  tags           String[]       @default([])

  // Denormalized purchase statistics, maintained by transaction writes (Phase 3+).
  totalSpend      Decimal   @default(0) @map("total_spend") @db.Decimal(14, 2)
  purchaseCount   Int       @default(0) @map("purchase_count")
  lastPurchaseAt  DateTime? @map("last_purchase_at")
  lastContactedAt DateTime? @map("last_contacted_at")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  identities   CustomerIdentity[]
  events       CustomerEvent[]
  transactions Transaction[]
  leads        Lead[]

  @@index([businessId, deletedAt, name])
  @@index([businessId, deletedAt, createdAt])
  @@map("customers")
}

model CustomerIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  type       IdentityType
  // Normalized value (E.164 for PHONE, lowercase for EMAIL).
  value      String
  createdAt  DateTime     @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, type, value])
  @@index([customerId])
  @@map("customer_identities")
}

model CustomerEvent {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @map("business_id") @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  type       CustomerEventType
  title      String
  // Structured event data (amounts, product names, ...). Never store secrets here.
  payload    Json?
  occurredAt DateTime          @default(now()) @map("occurred_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, customerId, occurredAt(sort: Desc)])
  @@map("customer_events")
}

// ============================================================
// Phase 3 — Products, transactions, payments
// ============================================================

enum TransactionStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  CARD
  OTHER
}

model Product {
  id                  String   @id @default(uuid()) @db.Uuid
  businessId          String   @map("business_id") @db.Uuid
  name                String
  sku                 String?
  category            String?
  price               Decimal  @db.Decimal(14, 2)
  costPrice           Decimal? @map("cost_price") @db.Decimal(14, 2)
  // Days after a purchase when the customer is likely to need this again
  // — drives REORDER_DUE recommendations (Phase 6/7).
  reorderIntervalDays Int?     @map("reorder_interval_days")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    TransactionItem[]
  leads    Lead[]

  @@unique([businessId, sku])
  @@index([businessId, active, name])
  @@map("products")
}

model Transaction {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @map("business_id") @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  // Total sale value; amountDue is always derived as amount - amountPaid.
  amount        Decimal           @db.Decimal(14, 2)
  amountPaid    Decimal           @default(0) @map("amount_paid") @db.Decimal(14, 2)
  // Derived from amount/amountPaid on every write (REFUNDED/CANCELLED are explicit).
  status        TransactionStatus
  occurredAt    DateTime          @map("occurred_at")
  paymentMethod PaymentMethod?    @map("payment_method")
  source        CustomerSource    @default(MANUAL)
  externalId    String?           @map("external_id")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    TransactionItem[]
  payments Payment[]

  @@unique([businessId, externalId])
  @@index([businessId, customerId, occurredAt(sort: Desc)])
  @@index([businessId, status])
  @@map("transactions")
}

model TransactionItem {
  id            String  @id @default(uuid()) @db.Uuid
  businessId    String  @map("business_id") @db.Uuid
  transactionId String  @map("transaction_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  // Snapshot of the product name at sale time (survives product edits).
  description String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  subtotal    Decimal @db.Decimal(14, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([businessId, productId])
  @@map("transaction_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  transactionId String        @map("transaction_id") @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod @default(CASH)
  occurredAt    DateTime      @map("occurred_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("payments")
}

// ============================================================
// Phase 4 — Leads
// ============================================================

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

model Lead {
  id         String  @id @default(uuid()) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  productId  String? @map("product_id") @db.Uuid
  // What the customer is interested in when there is no catalog product.
  description    String?
  status         LeadStatus     @default(NEW)
  source         CustomerSource @default(MANUAL)
  estimatedValue Decimal?       @map("estimated_value") @db.Decimal(14, 2)
  notes          String?
  // Recency signal for HOT_LEAD scoring (Phase 6/7); bumped on every change.
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([businessId, status, lastActivityAt(sort: Desc)])
  @@index([businessId, customerId])
  @@map("leads")
}

// ============================================================
// Phase 5 — CSV/XLSX import (staging, never direct to production tables)
// ============================================================

enum ImportFileType {
  CSV
  XLSX
}

enum ImportStatus {
  PENDING_MAPPING
  VALIDATING
  PREVIEW
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
  IMPORTED
  SKIPPED
  FAILED
}

model ImportJob {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  fileName    String         @map("file_name")
  fileType    ImportFileType @map("file_type")
  status      ImportStatus   @default(PENDING_MAPPING)
  // Detected source column headers, in order.
  columns          Json
  suggestedMapping Json  @map("suggested_mapping")
  // Confirmed mapping: { targetField: sourceHeader }.
  mapping Json?

  totalRows     Int @default(0) @map("total_rows")
  validRows     Int @default(0) @map("valid_rows")
  invalidRows   Int @default(0) @map("invalid_rows")
  duplicateRows Int @default(0) @map("duplicate_rows")
  importedRows  Int @default(0) @map("imported_rows")
  skippedRows   Int @default(0) @map("skipped_rows")

  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rows     ImportRow[]

  @@index([businessId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

model ImportRow {
  id          String          @id @default(uuid()) @db.Uuid
  businessId  String          @map("business_id") @db.Uuid
  importJobId String          @map("import_job_id") @db.Uuid
  rowNumber   Int             @map("row_number")
  // Original cell values keyed by source header.
  raw Json
  // Normalized values after mapping (name, phone E.164, amount, ...).
  normalized Json?
  status     ImportRowStatus @default(PENDING)
  // [{ field, message }] for INVALID rows.
  errors                Json?
  duplicateOfCustomerId String? @map("duplicate_of_customer_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@map("import_rows")
}

model BusinessMembership {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_memberships")
}
